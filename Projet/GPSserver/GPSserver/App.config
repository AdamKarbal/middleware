<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2"/>
	</startup>
 <system.serviceModel>
  <bindings>
   <basicHttpBinding>
    <binding name="BasicHttpBinding_IProxy" />
    <binding name="BasicHttpBinding_IProxy1" />
    <binding name="BasicHttpBinding_IProxy2" />
    <binding name="BasicHttpBinding_IProxy3" />
    <binding name="BasicHttpBinding_IProxy4" />
    <binding name="BasicHttpBinding_IProxy5" />
    <binding name="BasicHttpBinding_IProxy6" />
    <binding name="BasicHttpBinding_IProxy7" />
    <binding name="BasicHttpBinding_IProxy8" />
   </basicHttpBinding>
  </bindings>
  <client>
   <endpoint address="http://localhost:8090/ProxyCache" binding="basicHttpBinding"
    bindingConfiguration="BasicHttpBinding_IProxy" contract="ProxyCache.IProxy"
    name="BasicHttpBinding_IProxy" />
   <endpoint address="http://localhost:8090/ProxyCache" binding="basicHttpBinding"
    bindingConfiguration="BasicHttpBinding_IProxy1" contract="ProxyCache.IProxy"
    name="BasicHttpBinding_IProxy1" />
   <endpoint address="http://localhost:8090/ProxyCache" binding="basicHttpBinding"
    bindingConfiguration="BasicHttpBinding_IProxy2" contract="ProxyCache.IProxy"
    name="BasicHttpBinding_IProxy2" />
   <endpoint address="http://localhost:8090/ProxyCache" binding="basicHttpBinding"
    bindingConfiguration="BasicHttpBinding_IProxy3" contract="ServiceReference1.IProxy"
    name="BasicHttpBinding_IProxy3" />
   <endpoint address="http://localhost:8090/ProxyCache" binding="basicHttpBinding"
    bindingConfiguration="BasicHttpBinding_IProxy4" contract="ProxyCache.IProxy"
    name="BasicHttpBinding_IProxy4" />
   <endpoint address="http://localhost:8090/ProxyCache" binding="basicHttpBinding"
    bindingConfiguration="BasicHttpBinding_IProxy5" contract="ServiceReference1.IProxy"
    name="BasicHttpBinding_IProxy5" />
   <endpoint address="http://localhost:8090/ProxyCache" binding="basicHttpBinding"
    bindingConfiguration="BasicHttpBinding_IProxy6" contract="ServiceReference1.IProxy"
    name="BasicHttpBinding_IProxy6" />
   <endpoint address="http://localhost:8090/ProxyCache" binding="basicHttpBinding"
    bindingConfiguration="BasicHttpBinding_IProxy7" contract="ServiceReference1.IProxy"
    name="BasicHttpBinding_IProxy7" />
   <endpoint address="http://localhost:8090/ProxyCache" binding="basicHttpBinding"
    bindingConfiguration="BasicHttpBinding_IProxy8" contract="ProxyServiceClient.IProxy"
    name="BasicHttpBinding_IProxy8" />
  </client>
 </system.serviceModel>
</configuration>
