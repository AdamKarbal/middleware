<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <system.serviceModel>
        <bindings>
            <basicHttpBinding>
                <binding name="BasicHttpBinding_IProxy" />
            </basicHttpBinding>
        </bindings>
        <client>
            <endpoint address="http://localhost:8090/ProxyCache" binding="basicHttpBinding"
                bindingConfiguration="BasicHttpBinding_IProxy" contract="IProxy"
                name="BasicHttpBinding_IProxy" />
        </client>
    </system.serviceModel>
</configuration>